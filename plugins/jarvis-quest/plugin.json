    { "from": "desktop/i18n/xr.ts", "to": "packages/shared/src/i18n/tr/xr.ts" },
    { "from": "docs/protokol-test-vektoru.json", "to": "docs/protokol-test-vektoru.json" }
  ],
  "moduleIds": ["xr"],
  "dependencies": { "qrcode": "1.5.4" },
  "devDependencies": { "@types/qrcode": "1.5.6" }
}
